# Get a key at https://platform.openai.com/api-keys
# Note: this is pay-as-you-go API billing. A ChatGPT Plus or Pro subscription
# does NOT include it. Copy this file to `.env`. .env is gitignored.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5.1.
# gpt-5.1       balanced, the default
# gpt-5.2       newest, strongest judgment
# gpt-5-mini    noticeably cheaper and faster, slightly blunter drafts
# XCOPILOT_MODEL=gpt-5.1

# Optional reasoning effort: minimal | low | medium | high
# Defaults to low, which is what keeps a draft feeling instant.
# Drop to minimal if it feels slow, raise if drafts feel shallow.
# XCOPILOT_EFFORT=low
